-- DRAG PANEL
local dragging = false
local dragStart
local startPos

panel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = panel.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then

        local delta = input.Position - dragStart

        local target = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )

        TweenService:Create(
            panel,
            TweenInfo.new(0.04),
            {Position = target}
        ):Play()
    end
end)

-- FPS
local frames = 0
local fps = 0
local lastFPS = os.clock()

RunService.RenderStepped:Connect(function()
    frames += 1

    local now = os.clock()

    if now - lastFPS >= 1 then
        fps = frames
        frames = 0
        lastFPS = now
    end
end)

-- PLAY TIME
local joinTime = os.clock()

local function formatTime(seconds)
    seconds = math.floor(seconds)

    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60

    return string.format("%02d:%02d:%02d", h, m, s)
end

-- HANOI TIME
local function getHanoiTime()
    return os.date("!%H:%M:%S", os.time() + 7 * 60 * 60)
end

-- RGB 24-BIT
local hue = 0

RunService.RenderStepped:Connect(function(dt)
    if settings.rgb then
        hue = (hue + dt * settings.rgbSpeed) % 1
        text.TextColor3 = Color3.fromHSV(hue, 1, 1)
    else
        text.TextColor3 = Color3.new(1, 1, 1)
    end
end)

-- UPDATE INFO
task.spawn(function()
    while task.wait(0.2) do

        if not settings.enabled then
            infoFrame.Visible = false
            continue
        end

        infoFrame.Visible = true

        local lines = {}

        if settings.ping then
            local ping = 0

            pcall(function()
                ping = math.floor(
                    Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                )
            end)

            table.insert(lines, "PING    : " .. ping .. " ms")
        end

        if settings.fps then
            table.insert(lines, "FPS     : " .. fps)
        end

        if settings.players then
            table.insert(
                lines,
                "PLAYERS : " .. #Players:GetPlayers()
            )
        end

        if settings.playTime then
            table.insert(
                lines,
                "TIME    : " .. formatTime(os.clock() - joinTime)
            )
        end

        if settings.hanoi then
            table.insert(
                lines,
                "HANOI   : " .. getHanoiTime()
            )
        end

        text.Text = table.concat(lines, "\n")
    end
end)

